# Go backend that /api/* and /healthz are proxied to (server side only).
# Read by `next build` (compiled rewrites) and, when set at runtime, by src/proxy.ts.
BACKEND_URL=http://localhost:8080

# Solana RPC used by the checkout to fetch a recent blockhash for wallet payments.
# The public defaults are rate limited; use your own endpoint in production.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
